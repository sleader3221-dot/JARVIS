# Copy this file to .env and fill in your key. Never commit .env.

# Required: your Claude API key from https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional settings (defaults shown) ---

# Claude model and effort (low | medium | high | xhigh | max). Low keeps voice replies fast.
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_EFFORT=low
# JARVIS_MAX_TOKENS=4096

# Number of recent exchanges JARVIS remembers (0 disables memory).
# JARVIS_MEMORY_TURNS=10

# Let Claude search the web to answer questions about current events.
# JARVIS_WEB_SEARCH=true

# How to start listening: wake (say the wake word) | ptt (press Enter) | text (type).
# JARVIS_MODE=wake
# Comma-separated; add words your microphone often mishears the wake word as.
# JARVIS_WAKE_WORDS=jarvis,jervis

# Speech recognition language.
# JARVIS_LANGUAGE=en-US

# Voice: speaking rate in words per minute, and part of a voice name (e.g. David, Zira).
# JARVIS_TTS_RATE=185
# JARVIS_TTS_VOICE=

# Search engine used by "search for ..." ({query} is replaced with the search terms).
# JARVIS_SEARCH_URL=https://www.google.com/search?q={query}
